# Copy to .env and fill in. Never commit .env (it is in .gitignore).
BELEGFLUSS_ENVIRONMENT=local
BELEGFLUSS_STORAGE_DIR=var/documents
BELEGFLUSS_MATCHES_DIR=var/matches
BELEGFLUSS_MAX_UPLOAD_MB=20
BELEGFLUSS_MASTER_DATA_DIR=data/synthetic/master_data
BELEGFLUSS_CONTRACTS_DIR=data/synthetic/contracts
BELEGFLUSS_ERP_ORDERS_DIR=data/synthetic/sets

# LLM: needed for PDFs and scans (e-invoices never reach the model) and for the LLM adjudicator.
BELEGFLUSS_LLM_PROVIDER=openai
# Any model with image input and structured outputs, see https://platform.openai.com/docs/models
# gpt-6-luna is the low-cost option in October 2026.
BELEGFLUSS_LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Contract index (RAG). Without a database URL an in-memory index is built on start-up.
# Start the database with `make db-up`; docker compose sets this URL for the API container.
BELEGFLUSS_DATABASE_URL=postgresql://belegfluss:belegfluss@localhost:5432/belegfluss
# Empty = offline hashing embedder (lexical baseline, no API calls).
BELEGFLUSS_EMBEDDING_MODEL=text-embedding-3-small
BELEGFLUSS_EMBEDDING_DIMENSIONS=512
# auto = LLM adjudicator if an LLM is configured, otherwise the deterministic baseline
BELEGFLUSS_ADJUDICATOR=auto
