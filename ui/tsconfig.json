{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "rootDir": "src",
    "outDir": "../src/belegfluss/ui",
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
